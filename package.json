{
  "name": "inou",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "start:cloud": "node --env-file-if-exists=.env.cloud-test.local server/cloud-local.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "express": "5.3.0",
    "ioredis": "6.0.0",
    "jsqr": "^1.4.0",
    "lucide-react": "1.70.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "web-push": "^3.6.7",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.7",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0"
  },
  "overrides": {
    "deepmerge": "4.1.1",
    "glob": "14.0.4",
    "minimatch": "11.0.5"
  }
}
