PORT=8787
# Public deployment only. Exact HTTPS origin, no trailing slash.
# APP_ORIGIN=https://chat.example.com
# STUN defaults to stun:stun.l.google.com:19302 when unset. Set your own to override.
# STUN_URL=stun:turn.example.com:3478
# TURN_URL=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SECRET=replace-with-a-server-only-shared-secret
# Web Push 需要一对 VAPID 密钥（用 `npx web-push generate-vapid-keys` 生成）。
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Vercel backend: set via the Redis integration, never VITE_ variables.
# REDIS_URL=rediss://default:password@host:6379
# Keep preview and production metadata separate.
# REDIS_NAMESPACE=inou-preview-v1
